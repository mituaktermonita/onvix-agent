# Existing deployment? Keep your original .env; NEVER overwrite it with this template.
# Preserve STORAGE_ENCRYPTION_KEY and API_KEY_SECRET when migrating persistent state.
# Copy to .env and fill in. Blank secrets marked (auto) are generated by deploy.py and saved back here.
DAYTONA_API_KEY=

# Telegram: OpenClaw bot (posts in topics) + control bot (DM with Start button)
TELEGRAM_BOT_TOKEN=
CONTROL_BOT_TOKEN=
OWNER_ID=
TG_CHAT_ID=-100xxxxxxxxxx
# Use three distinct topic IDs > 1; General topic 1 belongs to the main agent.
TG_TOPIC_CODING=
TG_TOPIC_WRITING=
TG_TOPIC_VIDEO=

# Google Drive (dedicated account, OAuth refresh token) + one folder id per agent
GDRIVE_CLIENT_ID=
GDRIVE_CLIENT_SECRET=
GDRIVE_REFRESH_TOKEN=
GDRIVE_FOLDER_CODING=
GDRIVE_FOLDER_WRITING=
GDRIVE_FOLDER_VIDEO=

# (auto)
OMNIROUTE_PASSWORD=
JWT_SECRET=
API_KEY_SECRET=
STORAGE_ENCRYPTION_KEY=
LAUNCHER_TOKEN=
OPENCLAW_GATEWAY_TOKEN=
